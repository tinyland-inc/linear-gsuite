load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "linear_gsuite",
    srcs = glob(["src/**/*.ts"]),
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/effect",
    ],
)

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts", "tests/**/*.ts"]),
    declaration = False,
    no_emit = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig.typecheck.json",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/effect",
    ],
)

vitest_bin.vitest_test(
    name = "test",
    data = glob([
        "src/**/*.ts",
        "tests/**/*.ts",
        "examples/**/*.json",
    ]) + [
        ":node_modules",
        ":node_modules/vitest",
        "tsconfig.typecheck.json",
    ],
    args = [
        "run",
        "--reporter=verbose",
    ],
    log_level = "info",
)

npm_package(
    name = "pkg",
    srcs = [
        "LICENSE",
        "README.md",
        "package.json",
        ":linear_gsuite",
    ] + glob([
        "examples/**/*.json",
        "nix/**/*.nix",
    ]),
    package = "@tummycrypt/linear-gsuite",
    version = "0.1.0",
    tags = ["manual"],
)

exports_files([
    "package.json",
    "tsconfig.json",
    "tsconfig.typecheck.json",
])
